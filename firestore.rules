rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/private/vault {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['packet', 'updatedAt'])
        && request.resource.data.packet is map
        && request.resource.data.packet.format == 'meu-controle-vault'
        && request.resource.data.packet.ciphertext is string
        && request.resource.data.packet.ciphertext.size() < 800000
        && request.resource.data.packet.salt is string
        && request.resource.data.packet.iv is string;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/private/vault {
      function isOwner() {
        return request.auth != null && request.auth.uid == userId;
      }
      function validVault() {
        let p = request.resource.data.packet;
        return request.resource.data.keys().hasOnly(['packet', 'updatedAt'])
          && request.resource.data.keys().hasAll(['packet', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && p is map
          && p.keys().hasOnly(['format','version','kdf','iterations','salt','iv','ciphertext'])
          && p.keys().hasAll(['format','version','kdf','iterations','salt','iv','ciphertext'])
          && p.format == 'meu-controle-vault'
          && p.version == 3
          && p.kdf == 'PBKDF2-SHA256'
          && p.iterations == 310000
          && p.salt is string && p.salt.size() <= 128
          && p.iv is string && p.iv.size() <= 128
          && p.ciphertext is string && p.ciphertext.size() > 0
          && p.ciphertext.size() < 800000;
      }
      allow get: if isOwner();
      allow list: if false;
      allow create, update: if isOwner() && validVault();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
